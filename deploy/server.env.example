# File del server, permessi riservati all'account del servizio.
ALTERECHO_HOME=/var/lib/alterecho
ALTERECHO_HOST=127.0.0.1
ALTERECHO_PORT=8765
# Locale: token generato automaticamente; rete: token esplicito >=32 caratteri.
# ALTERECHO_TOKEN_FILE=/etc/alterecho/service-token
# ALTERECHO_ORIGINS=https://echo.example.org
# ALTERECHO_ALLOWED_HOSTS=echo.example.org,127.0.0.1,localhost
# ALTERECHO_PROXY_IPS=127.0.0.1
# ALTERECHO_OLLAMA_HOSTS=ollama,host.docker.internal,192.168.1.20
# CODEX_HOME=/var/lib/alterecho-codex
# OPENAI_API_KEY e OPENROUTER_API_KEY solo nell'ambiente del server.
